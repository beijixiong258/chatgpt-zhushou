{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chatgpt对话助手",
  "mainBinaryName": "chatgpt对话助手",
  "identifier": "com.ccswitch.history-editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "chatgpt对话助手",
        "width": 1120,
        "height": 730,
        "minWidth": 780,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        "history-editor"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
